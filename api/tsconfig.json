{
  "compilerOptions": {
    // Layout
    "rootDir": "..", // inclui ../shared (contrato com o frontend)
    "outDir": "./dist",

    // Ambiente: Node.js com ES Modules ("type": "module" no package.json)
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],

    // Checagem estrita
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Módulos
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src", "../shared"]
}
